<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Connections", application_connections_path, class: "text-blue-500 hover:text-blue-700" %>
  </div>

  <div class="bg-white shadow rounded-lg p-6 mb-8">
    <div class="flex items-center mb-4">
      <div class="bg-blue-100 p-3 rounded-lg mr-4">
        <i class="fas fa-<%= @integration.logo %> text-blue-500"></i>
      </div>
      <div>
        <h1 class="text-2xl font-bold"><%= @integration.name %></h1>
        <p class="text-gray-500"><%= @application_connection.name %></p>
      </div>
    </div>

    <div class="mb-4">
      <div class="flex items-center">
        <span class="mr-2 <%= @application_connection.active? ? 'text-green-500' : 'text-red-500' %>">
          <i class="fas fa-<%= @application_connection.active? ? 'check-circle' : 'times-circle' %>"></i>
        </span>
        <span>Status: <%= @application_connection.active? ? 'Active' : 'Inactive' %></span>
      </div>
    </div>

    <div class="flex justify-end">
      <%= button_to "Disconnect", application_connection_path(@application_connection), method: :delete, 
          data: { confirm: "Are you sure you want to disconnect this application?" }, 
          class: "text-red-500 hover:text-red-700" %>
    </div>
  </div>

  <% if @integration.slug == 'google_calendar' && @application_connection.active_and_valid? %>
    <div class="mb-8">
      <h2 class="text-xl font-semibold mb-4">Your Calendars</h2>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Primary</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @calendars.each do |calendar| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= calendar.summary %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if calendar.primary %>
                    <span class="text-green-500"><i class="fas fa-check-circle"></i> Yes</span>
                  <% else %>
                    <span class="text-gray-400">No</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h2 class="text-xl font-semibold mb-4">Upcoming Events</h2>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Start</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">End</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @events.any? %>
              <% @events.each do |event| %>
                <tr>
                  <td class="px-6 py-4">
                    <%= event.summary %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= event.start.date_time&.to_time&.strftime("%b %d, %Y %I:%M %p") || event.start.date %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= event.end.date_time&.to_time&.strftime("%b %d, %Y %I:%M %p") || event.end.date %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="3" class="px-6 py-4 text-center text-gray-500">No upcoming events</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
